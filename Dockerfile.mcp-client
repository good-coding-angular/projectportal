FROM mcr.microsoft.com/dotnet/sdk:10.0 AS builder
WORKDIR /app

# Restore dependencies
COPY projektportal-mcp-client/*.csproj ./
RUN dotnet restore

# Build and publish
COPY projektportal-mcp-client ./
RUN dotnet publish -c Release -o out

# Runtime image
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS final
WORKDIR /app
COPY --from=builder /app/out .

ENTRYPOINT ["dotnet", "projektportal-mcp-client.dll"]
